{
    "name": "fastflow_pathology",
    "gpu_ids": [0],
    "seed": -1,
    "finetune_norm": false,
    
    "path": {
        "base_dir": "experiments", //update
        "results": "results",
        "checkpoint": "checkpoint",
        "resume_path": null,
        "resume_state": null
    },
    "datasets": {
        "train": {
            "dataset": {
                "data_root": "data/train/imgs", //update
                "data_len": -1,
                "image_size":[224, 224],
                "data_aug": true
            },
            "dataloader":{
                "batch_size": 32, 
                "num_workers": 4,
                "shuffle": true,
                "pin_memory": true,
                "drop_last": true
            }
        },
        "val": {
            "dataset": {
                "imgs_root": "data/test/imgs", //update
                "gts_root": "data/test/gts",   //update
                "data_len": -1,
                "image_size":[224, 224],
                "target_size":[256, 256],
                "data_aug": true
            },
            "dataloader":{
                "batch_size": 32, 
                "num_workers": 4,
                "shuffle": false,
                "pin_memory": true,
                "drop_last": false
            }
        }
    },
    "model": {
        "backbone_name": "hf_hub:prov-gigapath/prov-gigapath",
